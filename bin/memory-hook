#!/usr/bin/env bash
# memory-hook: print a project's Claude Code auto-memory plus Claude Code's own
# memory instructions, for agents that do not load it natively (Droid, Codex,
# OpenCode, Pi, Antigravity). Reads memory through ../lib/read-memory.sh and
# the instructions from ../lib/memory-prompt.md, relative to this script.
#
# Usage: memory-hook droid|codex|agy|text < hook-input.json
#   droid, codex  emit SessionStart JSON (hookSpecificOutput.additionalContext)
#   agy           emit PreInvocation JSON (injectSteps userMessage), once per
#                 conversation: skipped when the transcript already holds it
#   text          emit plain text (OpenCode plugin, Pi extension)
# The working directory comes from the input's "cwd" field (agy: the first of
# "workspacePaths"), else $PWD.
# Prints nothing (agy: {}) and exits 0 on any failure, so a broken hook never
# blocks a session.

set -uo pipefail

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
ROOT="$(cd "$(dirname "$self")/.." && pwd -P)"
READER="$ROOT/lib/read-memory.sh"
PROMPT="$ROOT/lib/memory-prompt.md"
fmt="${1:-text}"

# Antigravity expects a JSON object on stdout even when there is nothing to add.
skip() { [ "$fmt" = agy ] && echo '{}'; exit 0; }

input="$(cat 2>/dev/null || true)"
cwd=""
if [ -n "$input" ] && command -v jq >/dev/null 2>&1; then
  cwd="$(printf '%s' "$input" | jq -r '.cwd // .workspacePaths[0]? // empty' 2>/dev/null || true)"
fi

# Antigravity runs PreInvocation before every model call and has no session-start
# event. The injected user message stays in the conversation, so inject only when
# the transcript does not already contain one.
if [ "$fmt" = agy ]; then
  command -v jq >/dev/null 2>&1 || skip
  transcript="$(printf '%s' "$input" | jq -r '.transcriptPath // empty' 2>/dev/null || true)"
  if [ -n "$transcript" ] && [ -f "$transcript" ] \
    && grep -F '"type":"USER_INPUT"' "$transcript" 2>/dev/null | grep -qF '<project-memory>'; then
    skip
  fi
fi

[ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$PWD"
[ -x "$READER" ] || skip

own="$("$READER" --dir "$cwd" 2>/dev/null)" || skip
[ -f "$PROMPT" ] || skip

# The instructions are Claude Code's own "# Memory" system prompt section
# (lib/memory-prompt.md), with the directory filled in.
if [ -d "$own" ]; then
  dir_note="This directory already exists — write to it directly with your file tools (do not run mkdir or check for its existence)."
else
  dir_note="This directory does not exist yet — create it with mkdir -p when you save the first memory."
fi
instructions="$(cat "$PROMPT")"
instructions="${instructions//\{\{MEMORY_DIR\}\}/$own}"
instructions="${instructions//\{\{DIR_NOTE\}\}/$dir_note}"

# The index block mirrors how Claude Code loads MEMORY.md: a "Contents of ..."
# header, then the index cut at 200 lines or 25,000 bytes with its warning.
list="$("$READER" --list "$cwd" 2>/dev/null)" || list=""
memdir="$(dirname "$(printf '%s\n' "$list" | head -1)")"
index="$memdir/MEMORY.md"
if [ -n "$list" ] && [ -f "$index" ]; then
  contents="$(jq -rn --rawfile c "$index" '
    def kb: (. / 1000 * 10 | round / 10 | tostring) + "KB";
    ($c | sub("^\\s+"; "") | sub("\\s+$"; "")) as $t
    | ($t | split("\n")) as $lines | ($lines | length) as $r | ($t | utf8bytelength) as $s
    | if $r <= 200 and $s <= 25000 then $t else
        (if $r > 200 then $lines[:200] | join("\n") else $t end) as $w0
        | (if ($w0 | length) > 25000 then ($w0[:25000] | rindex("\n")) as $j
             | (if $j != null and $j > 0 then $w0[:$j] else $w0[:25000] end)
           else $w0 end) as $w
        | (if $t[($w | length):($w | length) + 1] == "\n" then ($w | split("\n") | length) else 0 end) as $b
        | ($t[($w | length) + 1:] | split("\n")[0] | ltrimstr(" ") | .[:80]) as $next
        | (if $b == 0 then "everything after the first \($w | length) characters of line 1 was cut off"
           else "\($r - $b) of \($r) lines were cut off, starting at line \($b + 1)" + (if $next != "" then " (\"\($next)\")" else "" end) end) as $i
        | (if $s > 25000 and $r <= 200 then "\($s | kb) (limit: \(25000 | kb)) — index entries are too long"
           elif $r > 200 and $s <= 25000 then "\($r) lines (limit: 200)"
           else "\($r) lines and \($s | kb)" end) as $a
        | "\($w)\n\n> WARNING: MEMORY.md is \($a). Only part of it was loaded: \($i). Keep index entries to one line under ~200 chars; move detail into topic files."
      end' 2>/dev/null)" || contents="$(cat "$index")"
  [ -n "$contents" ] || contents="Your MEMORY.md is currently empty. When you save new memories, they will appear here."
  memory="Contents of $index (user's auto-memory, persists across conversations):

$contents"
  if [ "$memdir" != "$own" ]; then
    memory="$memory

NOTE: this project has no memory of its own. The index above belongs to the nearest ancestor project. Treat it as background, and save new memories for this project to $own."
  fi
  drift="$("$READER" "$cwd" 2>/dev/null | sed -n '/^===== index drift/,$p' | sed 1d)"
  [ -z "$drift" ] || memory="$memory

MEMORY.md and the memory files have drifted apart. Fix this while you are here:
$drift"
else
  memory="Your MEMORY.md is currently empty. When you save new memories, they will appear here."
fi

body="$instructions

<project-memory>
$memory
</project-memory>"

case "$fmt" in
  droid)
    jq -n --arg ctx "$body" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}, suppressOutput: true}'
    ;;
  codex)
    jq -n --arg ctx "$body" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}}'
    ;;
  agy)
    jq -n --arg ctx "$body" '{injectSteps: [{userMessage: $ctx}]}' || echo '{}'
    ;;
  *)
    printf '%s\n' "$body"
    ;;
esac
